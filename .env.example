# PostgreSQL used by the local migration runner and future API modules.
POSTGRES_DB=chronelle
POSTGRES_USER=chronelle
POSTGRES_PASSWORD=chronelle_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chronelle:chronelle_dev@localhost:5432/chronelle

# Local application ports.
API_HOST=0.0.0.0
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Future local filesystem storage adapter root.
LOCAL_STORAGE_ROOT=.chronelle/storage
