# PostgreSQL used by the local migration runner and future API modules.
POSTGRES_DB=chronelle
POSTGRES_USER=chronelle
POSTGRES_PASSWORD=chronelle_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chronelle:chronelle_dev@localhost:5432/chronelle

# Private container preview only: set a separate 24-128 character URL-safe secret.
RUNTIME_DATABASE_PASSWORD=

# Development sign-in: asserts an identity from an email, no password. Off in a deployment.
# The API flag registers the route; the web flag renders /sign-in/development.
ENABLE_DEVELOPMENT_AUTH=true
WEB_DEVELOPMENT_SIGN_IN=true
AUTH_SESSION_TTL_MINUTES=20160

# Verified WeChat sign-in and explicit account linking. Keep disabled until
# migration 0071 is applied and CloudBase authentication is configured.
ENABLE_WECHAT_AUTH=false
# Comma-separated provider ids accepted from CloudBase /auth/v1/user/me.
CLOUDBASE_WECHAT_PROVIDER_IDS=wechat,weixin,wx,wx_openid
# Optional; bounded to 1-30 seconds. Defaults to 10000.
CLOUDBASE_AUTH_TIMEOUT_MS=10000

# WeChat Mini Program build-time configuration. Use an HTTPS API origin in
# deployed builds. The wx-cloud path applies only when this CloudBase environment
# is associated with the Mini Program in WeChat Cloud Development.
TARO_APP_API_BASE_URL=http://127.0.0.1:4000
TARO_APP_CLOUDBASE_ENV_ID=
TARO_APP_CLOUDBASE_USE_WX_CLOUD=false

# Email and password accounts: verification codes are emailed. The log provider
# writes them to the API log; file appends them as JSON lines to EMAIL_FILE_PATH
# for a staging instance with shell access; a deployment that mails them sets
# smtp with a transport URL and sender.
EMAIL_PROVIDER=log
AUTH_VERIFICATION_TTL_MINUTES=15
# EMAIL_FILE_PATH=/tmp/chronelle-emails.jsonl
# SMTP_URL=smtps://user:password@smtp.example.test:465
# EMAIL_FROM=Chronelle <no-reply@example.test>

# Administrative connection for disposable integration-test databases.
TEST_DATABASE_URL=postgresql://chronelle:chronelle_dev@localhost:5432/postgres

# Local application ports.
API_HOST=0.0.0.0
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000

# Private document storage. COS requires the additional configuration below.
DOCUMENT_STORAGE_PROVIDER=local-filesystem
LOCAL_STORAGE_ROOT=.chronelle/storage
DOCUMENT_TRANSFER_TTL_SECONDS=300

# Set DOCUMENT_STORAGE_PROVIDER=tencent-cos to use an existing private bucket.
# COS_BUCKET=your-bucket-1250000000
# COS_REGION=ap-guangzhou
# COS_SECRET_ID=
# COS_SECRET_KEY=
# Temporary credentials require both a security token and an ISO UTC expiry.
# COS_SECURITY_TOKEN=
# COS_CREDENTIALS_EXPIRE_AT=2026-10-01T12:00:00Z
# COS_KMS_KEY_ID=

# Which store serves the API: postgres (the default; DATABASE_URL required, the two
# CloudBase flags below are staged opt-ins) or cloudbase (every read and write through
# the gateway; DATABASE_URL unused; both flags implied). See docs/cloudbase-backend-runbook.md.
CHRONELLE_BACKEND=postgres
# CloudBase staging gateway probe only. Keep the API key server-side and local.
# The application remains PostgreSQL-backed unless this is explicitly enabled
# after the read-contract harness passes in staging. Search, the command state, the
# storage references, and the development sign-in call the gateway's rpc functions
# (migrations 0021, 0024, 0025, 0027); identity reads use the table route.
CLOUDBASE_READS_ENABLED=false
# Route typed create/update, linked creation, relation changes, object deletion, recovery, and revision restore, sharing, Event page layouts, reversible commands, and document transfers through the gateway's rpc functions (migrations 0012 to 0026).
# Requires CLOUDBASE_READS_ENABLED=true. Staging verification only until the port completes.
CLOUDBASE_WRITES_ENABLED=false
# Optional; bounded to 1-120 seconds. Defaults to 30000.
CLOUDBASE_REQUEST_TIMEOUT_MS=30000
# CLOUDBASE_ENV_ID=your-cloudbase-environment-id
# CLOUDBASE_APIKEY=your-short-lived-server-api-key
