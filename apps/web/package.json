{
  "name": "@chronelle/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @chronelle/api-client build && next build",
    "dev": "pnpm --filter @chronelle/api-client build && next dev",
    "start": "node scripts/start-standalone.mjs",
    "sandbox": "pnpm --filter @chronelle/api-client build && node sandbox/build.mjs",
    "test": "pnpm --filter @chronelle/api-client build && vitest run",
    "typecheck": "pnpm --filter @chronelle/api-client build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chronelle/api-client": "workspace:*",
    "@chronelle/schemas": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "26.1.0"
  }
}
